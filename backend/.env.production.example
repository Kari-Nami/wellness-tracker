# Copy outside the checkouts as ../.env.production, then chmod 600.
# Example credentials are placeholders. Set real values before starting.
PUBLIC_BASE_PATH=/webdev/wellness-tracker
APP_ORIGIN=https://example.com
FRONTEND_HOST_PORT=18080
BACKEND_HOST_PORT=13000
MONGO_ROOT_USERNAME=wellness_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-alphanumeric-password
# Percent-encode credentials if they contain URI-reserved characters.
MONGODB_URI=mongodb://wellness_admin:replace-with-a-strong-alphanumeric-password@mongo:27017/wellness_tracker?authSource=admin&replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
LOG_LEVEL=info

# Generate a stable replica-set authentication key: openssl rand -base64 756
MONGO_REPLICA_KEY=replace-with-a-base64-replica-set-key
