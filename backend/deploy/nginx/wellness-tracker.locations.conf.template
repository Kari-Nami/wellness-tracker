location = ${PUBLIC_BASE_PATH} {
    return 301 ${PUBLIC_BASE_PATH}/;
}
location = ${PUBLIC_BASE_PATH}/api {
    return 301 ${PUBLIC_BASE_PATH}/api/;
}
location ^~ ${PUBLIC_BASE_PATH}/api/ {
    proxy_pass http://127.0.0.1:${BACKEND_HOST_PORT}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location ^~ ${PUBLIC_BASE_PATH}/ {
    proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
